FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Deployment profile
# Built-in profiles: elda (generic sales/template site), bbb (Barefoot Beach Brides).
SITE_PROFILE=elda
# Optional scalar overrides. Leave blank to use the selected profile defaults.
BRAND_NAME=
BRAND_TAGLINE=
BRAND_LOCATION=
BRAND_DESCRIPTION=
BRAND_LOGO_PATH=
BRAND_LOGO_LIGHT_PATH=
BRAND_LOGO_ALT=
BRAND_FLORALS_LABEL=
BRAND_PHONE_DISPLAY=
BRAND_PHONE_URI=
BRAND_CONTACT_EMAIL=
BRAND_AREA_SERVED=

# Database
# Local dev defaults to SQLite when DATABASE_URL is not set.
# Every production/client deployment must have its own isolated database.
# Railway PostgreSQL example:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_TIMEOUT=8
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password
# MAIL_DEFAULT_SENDER and CONTACT_RECIPIENT may be omitted to use profile defaults.
MAIL_DEFAULT_SENDER=
CONTACT_RECIPIENT=
SITE_URL=
PREFERRED_URL_SCHEME=https
ENFORCE_CANONICAL_HOST=True
CLIENT_SELF_REGISTRATION_ENABLED=False
RATELIMIT_STORAGE_URI=memory://
CLIENT_LOGIN_GET_LIMIT=120 per hour
CLIENT_LOGIN_POST_LIMIT=5 per 15 minutes
CLIENT_REGISTER_GET_LIMIT=120 per hour
CLIENT_REGISTER_POST_LIMIT=3 per hour
ADMIN_LOGIN_GET_LIMIT=240 per hour
ADMIN_LOGIN_POST_LIMIT=12 per 15 minutes
EMAIL_CAMPAIGN_BATCH_SIZE=500
EMAIL_PROVIDER=smtp
EMAIL_PROVIDER_TIMEOUT_SECONDS=15
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_API_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_COMMUNICATION_UNDO_MINUTES=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSWORD_RESET_TOKEN_MAX_AGE=3600
SECURITY_HSTS_SECONDS=31536000
SECURITY_X_XSS_PROTECTION=1; mode=block
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
